{
  "name": "sisu-cancer-strategy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "data:import": "node scripts/import-data.js",
    "data:check": "node scripts/import-data.js --check",
    "data:refresh": "node scripts/refresh-data.js",
    "data:history": "node scripts/data-history.js",
    "data:rollback": "node scripts/data-history.js --rollback"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
